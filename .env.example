# 复制为 .env。留空模型配置也能解析附件；不要把密钥发到聊天或提交到 Git。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 通常自动查询机器人身份，无需填写
FEISHU_BOT_OPEN_ID=
# 可选：收到任务后回复本地网页链接
FEISHU_REPLY=true
WEB_URL=http://127.0.0.1:8000

# 兼容 OpenAI Chat Completions 的服务地址，例如服务商提供的 .../v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 留空直连；只有模型服务确实需要代理时才填写，例如 http://127.0.0.1:7890
MODEL_PROXY_URL=

# 扫描 PDF 专用视觉模型，必须支持图片输入。不会假定文字模型支持图片。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_PROXY_URL=
MAX_PDF_PAGES=30

MAX_FILE_MB=25
MAX_ZIP_MB=100
MAX_ZIP_ENTRIES=100
MAX_TEXT_CHARS=100000
# DOC 文件转换所需，可留空自动查找常见安装位置
LIBREOFFICE_PATH=

# 可选：本地 ONLYOFFICE 在线编辑，先运行 start-editor.ps1
ONLYOFFICE_URL=http://127.0.0.1:8082
ONLYOFFICE_BRIDGE_URL=http://host.docker.internal:8001
